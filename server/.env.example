# Template for the server environment.
#
#   local development:  cp server/.env.example server/.env
#   docker compose:     cp server/.env.example .env   (repository root)
#
# In the docker compose stack the database host is the service name `db`,
# not `localhost` - adjust DATABASE_URL/TEST_DATABASE_URL accordingly.

# --- database ---------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://territory:territory@localhost:5432/territory_map
TEST_DATABASE_URL=postgresql+psycopg://territory:territory@localhost:5432/territory_map_test
# docker compose variant:
# DATABASE_URL=postgresql+psycopg://territory:change-me@db:5432/territory_map
# TEST_DATABASE_URL=postgresql+psycopg://territory:change-me@db:5432/territory_map_test

# --- auth -------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
ADMIN_TOKEN_TTL_HOURS=12
ACCESS_CODE_TTL_HOURS=24

# --- application key ---------------------------------------------------------
# Shared key that both clients must send in the `X-App-Key` header on every
# request. `GET /health` is exempt (the deploy health check calls it keyless).
#
# Leave EMPTY to disable the gate -- which is what tests and local development
# use. The app logs a warning at startup when it is empty.
#
# Generate with: openssl rand -hex 32
#
# This is a shutter, not authentication: the value ships inside the APK and the
# desktop binary, so anyone holding either can read it. Do not treat it as a
# substitute for TLS or for the tokens.
APP_SECRET=

# --- http -------------------------------------------------------------------
# Comma-separated list; empty disables the CORS middleware.
CORS_ORIGINS=

# --- docker compose only ----------------------------------------------------
# Read by docker-compose.yml when it is placed at the repository root.
POSTGRES_USER=territory
POSTGRES_PASSWORD=change-me
API_PORT=8000
