# Loaded by the main process with dotenv (see src/main/index.ts, spec 0003 Task 07).
# Copy this file to .env and fill in real values — .env is gitignored.

# Base URL of the Territory Map server, e.g. http://localhost:8000 in
# development or https://your-domain.example in production.
API_BASE_URL=

# Same value as the server's APP_SECRET. Sent on every request as the
# X-App-Key header — see "Chave de aplicação" in the root AGENTS.md.
APP_KEY=
