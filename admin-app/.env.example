# Loaded at build time by react-native-config (see README.md).
# Copy this file to .env and fill in real values — .env is gitignored.

# Base URL of the Territory Map server, e.g. http://10.0.2.2:8000 from the
# Android emulator (localhost on the host machine) or https://your-domain.example
# in production.
API_BASE_URL=

# Same value as the server's APP_SECRET. Sent on every request as the
# X-App-Key header — see "Chave de aplicação" in the root AGENTS.md.
APP_KEY=
